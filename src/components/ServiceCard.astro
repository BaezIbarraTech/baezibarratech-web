---
interface Props {
	title: string;
	description: string;
	icon?: string;
	tags?: string[];
}

const { title, description, icon, tags = [] } = Astro.props;
---

<div class="service-card">
	<div class="card-glow-bg"></div>
	
	<div class="card-icon-wrapper">
		{icon ? (
			<div class="icon-inner" set:html={icon} />
		) : (
			<slot name="icon">
				<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="default-icon"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
			</slot>
		)}
	</div>

	<h3 class="card-title">{title}</h3>
	<p class="card-description">{description}</p>

	{tags.length > 0 && (
		<div class="card-tags">
			{tags.map((tag) => (
				<span class="tag-pill">{tag}</span>
			))}
		</div>
	)}

	<div class="card-footer">
		<span class="learn-more">Saber más</span>
		<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="arrow-icon"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
	</div>
</div>

<style>
	.service-card {
		position: relative;
		background: var(--bg-card);
		border: 1px solid var(--border-glass);
		border-radius: 20px;
		padding: 2.2rem;
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: hidden;
	}

	.card-glow-bg {
		position: absolute;
		top: -30%;
		left: -30%;
		width: 160%;
		height: 160%;
		background: radial-gradient(circle, rgba(0, 242, 254, 0.12) 0%, rgba(9, 251, 211, 0) 70%);
		opacity: 0;
		transition: opacity 0.5s ease;
		pointer-events: none;
		z-index: 0;
	}

	.service-card:hover {
		transform: translateY(-10px);
		background: var(--bg-card-hover);
		border-color: var(--border-glass-glow);
		box-shadow: 0 15px 35px -10px rgba(0, 242, 254, 0.35), 0 0 15px rgba(9, 251, 211, 0.2);
	}

	.service-card:hover .card-glow-bg {
		opacity: 1;
	}

	.card-icon-wrapper {
		position: relative;
		z-index: 1;
		width: 60px;
		height: 60px;
		border-radius: 14px;
		background: linear-gradient(135deg, rgba(0, 242, 254, 0.12), rgba(9, 251, 211, 0.05));
		border: 1px solid var(--border-glass-glow);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--neon-cyan);
		margin-bottom: 1.5rem;
		transition: all 0.3s ease;
		box-shadow: 0 0 15px rgba(0, 242, 254, 0.1);
	}

	.service-card:hover .card-icon-wrapper {
		background: linear-gradient(135deg, var(--neon-cyan), var(--neon-green));
		color: #0a0a0a;
		box-shadow: 0 0 20px rgba(0, 242, 254, 0.5);
		transform: scale(1.08);
	}

	.icon-inner {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.card-title {
		position: relative;
		z-index: 1;
		font-size: 1.35rem;
		font-weight: 700;
		color: var(--text-primary);
		margin-bottom: 0.9rem;
		line-height: 1.3;
	}

	.card-description {
		position: relative;
		z-index: 1;
		color: var(--text-secondary);
		font-size: 0.95rem;
		line-height: 1.6;
		margin-bottom: 1.8rem;
		flex-grow: 1;
	}

	.card-tags {
		position: relative;
		z-index: 1;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1.5rem;
	}

	.tag-pill {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--neon-green);
		background: rgba(9, 251, 211, 0.08);
		border: 1px solid rgba(9, 251, 211, 0.2);
		padding: 0.2rem 0.6rem;
		border-radius: 6px;
	}

	.card-footer {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--neon-cyan);
		font-weight: 600;
		font-size: 0.9rem;
		margin-top: auto;
		transition: transform 0.3s ease;
	}

	.service-card:hover .card-footer {
		color: var(--neon-green);
	}

	.service-card:hover .arrow-icon {
		transform: translateX(5px);
	}

	.arrow-icon {
		transition: transform 0.3s ease;
	}
</style>
