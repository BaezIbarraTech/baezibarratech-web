---
interface Props {
	formspreeEndpoint?: string;
}

const { formspreeEndpoint = "https://formspree.io/f/TU_ENDPOINT" } = Astro.props;
---

<section id="contacto" class="contact-section">
	<div class="contact-container">
		<div class="section-header text-center">
			<span class="section-tag">Hablemos de tu Proyecto</span>
			<h2 class="section-title">Contáctanos & <span class="text-gradient">Cotiza en Línea</span></h2>
			<p class="section-subtitle">
				¿Tienes una idea, necesitas optimizar tu infraestructura o requieres desarrollo de software a medida? Envíanos un mensaje y te responderemos a la brevedad.
			</p>
		</div>

		<div class="form-wrapper glass-card">
			<form action={formspreeEndpoint} method="POST" class="contact-form">
				<div class="form-grid">
					<!-- Nombre Completo -->
					<div class="input-group">
						<label for="name" class="input-label">Nombre Completo</label>
						<div class="input-wrapper">
							<input 
								type="text" 
								id="name" 
								name="name" 
								required 
								placeholder="Ej. Gabriel Báez"
								class="glass-input" 
							/>
							<svg class="input-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
						</div>
					</div>

					<!-- Correo Electrónico -->
					<div class="input-group">
						<label for="email" class="input-label">Correo Electrónico</label>
						<div class="input-wrapper">
							<input 
								type="email" 
								id="email" 
								name="email" 
								required 
								placeholder="contacto@tuempresa.com"
								class="glass-input" 
							/>
							<svg class="input-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
						</div>
					</div>
				</div>

				<!-- Mensaje -->
				<div class="input-group full-width">
					<label for="message" class="input-label">Mensaje o Requerimiento</label>
					<div class="input-wrapper">
						<textarea 
							id="message" 
							name="message" 
							rows="5" 
							required 
							placeholder="Cuéntanos detalles sobre tus necesidades tecnológicas (Web, DevOps, Software a medida, Soporte IT)..."
							class="glass-input textarea"
						></textarea>
					</div>
				</div>

				<!-- Botón de Envío -->
				<div class="form-submit">
					<button type="submit" class="btn-submit">
						<span>Enviar Mensaje</span>
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
					</button>
				</div>
			</form>
		</div>
	</div>
</section>

<style>
	.contact-section {
		padding: 6rem 2rem;
		position: relative;
	}

	.contact-container {
		max-width: 850px;
		margin: 0 auto;
	}

	.text-center {
		text-align: center;
	}

	.section-tag {
		font-family: var(--font-mono);
		color: var(--neon-cyan);
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		background: rgba(0, 242, 254, 0.08);
		border: 1px solid var(--border-glass-glow);
		padding: 0.3rem 1rem;
		border-radius: 20px;
		display: inline-block;
		margin-bottom: 1rem;
	}

	.section-title {
		font-size: 2.5rem;
		font-weight: 800;
		color: var(--text-primary);
		margin-bottom: 1rem;
	}

	.text-gradient {
		background: linear-gradient(135deg, var(--neon-cyan), var(--neon-green));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.section-subtitle {
		color: var(--text-secondary);
		font-size: 1.05rem;
		max-width: 650px;
		margin: 0 auto 3rem;
		line-height: 1.6;
	}

	.form-wrapper {
		background: var(--bg-card);
		border: 1px solid var(--border-glass-glow);
		border-radius: 24px;
		padding: 3rem;
		backdrop-filter: blur(18px);
		-webkit-backdrop-filter: blur(18px);
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), 0 0 30px rgba(0, 242, 254, 0.1);
		transition: border-color 0.3s ease, box-shadow 0.3s ease;
	}

	.form-wrapper:hover {
		border-color: rgba(0, 242, 254, 0.4);
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6), 0 0 35px rgba(0, 242, 254, 0.2);
	}

	@media (max-width: 600px) {
		.form-wrapper {
			padding: 1.8rem;
		}
	}

	.contact-form {
		display: flex;
		flex-direction: column;
		gap: 1.8rem;
	}

	.form-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem;
	}

	@media (max-width: 650px) {
		.form-grid {
			grid-template-columns: 1fr;
		}
	}

	.input-group {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.input-label {
		color: var(--text-primary);
		font-size: 0.9rem;
		font-weight: 600;
	}

	.input-wrapper {
		position: relative;
		display: flex;
		align-items: center;
	}

	.glass-input {
		width: 100%;
		background: rgba(10, 10, 10, 0.6);
		border: 1px solid var(--border-glass);
		border-radius: 12px;
		padding: 0.9rem 1rem 0.9rem 2.8rem;
		color: var(--text-primary);
		font-family: var(--font-sans);
		font-size: 0.95rem;
		outline: none;
		transition: all 0.3s ease;
	}

	.glass-input.textarea {
		padding-left: 1rem;
		resize: vertical;
	}

	.glass-input::placeholder {
		color: var(--text-muted);
	}

	.glass-input:focus {
		border-color: var(--neon-cyan);
		background: rgba(10, 10, 10, 0.85);
		box-shadow: 0 0 15px rgba(0, 242, 254, 0.3);
	}

	.input-icon {
		position: absolute;
		left: 1rem;
		color: var(--text-muted);
		pointer-events: none;
		transition: color 0.3s ease;
	}

	.glass-input:focus ~ .input-icon {
		color: var(--neon-cyan);
	}

	.form-submit {
		margin-top: 0.5rem;
		display: flex;
		justify-content: flex-end;
	}

	.btn-submit {
		width: 100%;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.7rem;
		padding: 1rem 2.2rem;
		background: linear-gradient(135deg, var(--neon-cyan), var(--neon-green));
		color: #0a0a0a;
		font-family: var(--font-sans);
		font-weight: 700;
		font-size: 1.05rem;
		border: none;
		border-radius: 12px;
		cursor: pointer;
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
		box-shadow: 0 0 20px rgba(0, 242, 254, 0.3);
	}

	.btn-submit:hover {
		transform: translateY(-3px);
		box-shadow: 0 10px 30px rgba(9, 251, 211, 0.5);
	}

	.btn-submit:active {
		transform: translateY(0);
	}
</style>
