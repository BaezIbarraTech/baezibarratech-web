---
interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "BaezIbarraTech SpA | Soluciones de Software, DevOps e Infraestructura",
	description = "Empresa líder en desarrollo web corporativo, software a medida con Python/FastAPI/PostgreSQL/Redis, DevOps, virtualización y soporte IT."
} = Astro.props;
---

<!dnctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<link rel="icon" type="image/svg+xml" href="/BI.svg" />
		<meta name="description" content={description} />
		<meta name="keywords" content="BaezIbarraTech, Desarrollo Web, Software a Medida, Python, FastAPI, PostgreSQL, Redis, DevOps, Virtualizacion, Soporte IT, Chile" />
		<meta name="author" content="BaezIbarraTech SpA" />

		<!-- OpenGraph / Social Meta Tags -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content="BaezIbarraTech SpA" />

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
	</head>
	<body>
		<!-- Glow background ambient effects -->
		<div class="ambient-glow glow-1"></div>
		<div class="ambient-glow glow-2"></div>
		<div class="bg-grid-pattern"></div>

		<!-- Sticky Navbar Header -->
		<header class="header">
			<nav class="nav-container">
				<a href="#" class="logo">
					<img src="/BI.svg" alt="BaezIbarraTech Logo" class="logo-img" />
					<span class="logo-text">BaezIbarra<span class="logo-accent">Tech</span></span>
				</a>
				<ul class="nav-links">
					<li><a href="#inicio">Inicio</a></li>
					<li><a href="#servicios">Servicios</a></li>
					<li><a href="#contacto">Contacto</a></li>
				</ul>
				<a href="#contacto" class="btn-nav">Cotizar Proyecto</a>
			</nav>
		</header>

		<!-- Main Page Content -->
		<main>
			<slot />
		</main>

		<!-- Footer -->
		<footer class="footer">
			<div class="footer-container">
				<div class="footer-brand">
					<div class="logo">
						<img src="/BI.svg" alt="BaezIbarraTech Logo" class="logo-img" />
						<span class="logo-text">BaezIbarra<span class="logo-accent">Tech</span> SpA</span>
					</div>
					<p class="footer-desc">
						Transformamos la infraestructura tecnológica y potenciamos el desarrollo de software de alta disponibilidad para empresas modernas.
					</p>
				</div>
				<div class="footer-links">
					<h4>Servicios</h4>
					<ul>
						<li><a href="#servicios">Desarrollo Web SEO</a></li>
						<li><a href="#servicios">Software a Medida</a></li>
						<li><a href="#servicios">DevOps & Cloud</a></li>
						<li><a href="#servicios">Soporte IT Corporativo</a></li>
					</ul>
				</div>
				<div class="footer-links">
					<h4>Navegación</h4>
					<ul>
						<li><a href="#inicio">Inicio</a></li>
						<li><a href="#servicios">Servicios</a></li>
						<li><a href="#contacto">Contacto</a></li>
					</ul>
				</div>
			</div>
			<div class="footer-bottom">
				<p>&copy; {new Date().getFullYear()} BaezIbarraTech SpA. Todos los derechos reservados.</p>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--bg-dark: #0a0a0a;
		--bg-card: rgba(18, 24, 38, 0.55);
		--bg-card-hover: rgba(26, 35, 56, 0.75);
		--border-glass: rgba(0, 242, 254, 0.15);
		--border-glass-glow: rgba(0, 242, 254, 0.45);
		
		--neon-cyan: #00f2fe;
		--neon-green: #09fbd3;
		--neon-blue: #4facfe;
		
		--text-primary: #f3f4f6;
		--text-secondary: #9ca3af;
		--text-muted: #6b7280;

		--font-sans: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
		--font-mono: 'JetBrains Mono', monospace;
	}

	*, *::before, *::after {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		scroll-behavior: smooth;
		font-family: var(--font-sans);
		background-color: var(--bg-dark);
		color: var(--text-primary);
		overflow-x: hidden;
	}

	body {
		background-color: var(--bg-dark);
		min-height: 100vh;
		position: relative;
		display: flex;
		flex-direction: column;
	}

	/* Custom Scrollbar */
	::-webkit-scrollbar {
		width: 10px;
	}
	::-webkit-scrollbar-track {
		background: #080808;
	}
	::-webkit-scrollbar-thumb {
		background: #1a2536;
		border-radius: 5px;
		border: 1px solid var(--border-glass);
	}
	::-webkit-scrollbar-thumb:hover {
		background: var(--neon-cyan);
		box-shadow: 0 0 10px var(--neon-cyan);
	}

	/* Ambient Background Glows */
	.ambient-glow {
		position: fixed;
		border-radius: 50%;
		filter: blur(140px);
		z-index: -2;
		pointer-events: none;
		opacity: 0.35;
	}

	.glow-1 {
		top: -10%;
		left: -10%;
		width: 500px;
		height: 500px;
		background: radial-gradient(circle, var(--neon-cyan) 0%, rgba(79, 172, 254, 0) 70%);
	}

	.glow-2 {
		bottom: 10%;
		right: -10%;
		width: 600px;
		height: 600px;
		background: radial-gradient(circle, var(--neon-green) 0%, rgba(9, 251, 211, 0) 70%);
	}

	.bg-grid-pattern {
		position: fixed;
		top: 0;
		left: 0;
		width: 100vw;
		height: 100vh;
		background-image: 
			linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
		background-size: 40px 40px;
		z-index: -1;
		pointer-events: none;
	}

	/* Header & Navbar */
	.header {
		position: sticky;
		top: 0;
		z-index: 50;
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		background: rgba(10, 10, 10, 0.75);
		border-bottom: 1px solid var(--border-glass);
	}

	.nav-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 1.1rem 2rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.logo {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		text-decoration: none;
		font-weight: 800;
		font-size: 1.35rem;
		color: var(--text-primary);
		letter-spacing: -0.02em;
	}

	.logo-img {
		height: 38px;
		width: auto;
		filter: drop-shadow(0 0 8px rgba(74, 222, 128, 0.5));
		transition: transform 0.3s ease, filter 0.3s ease;
	}

	.logo:hover .logo-img {
		transform: scale(1.08) rotate(3deg);
		filter: drop-shadow(0 0 14px rgba(74, 222, 128, 0.8));
	}

	.logo-accent {
		color: var(--neon-green);
	}

	.nav-links {
		display: flex;
		gap: 2rem;
		list-style: none;
	}

	.nav-links a {
		color: var(--text-secondary);
		text-decoration: none;
		font-size: 0.95rem;
		font-weight: 500;
		transition: all 0.3s ease;
	}

	.nav-links a:hover {
		color: var(--neon-cyan);
		text-shadow: 0 0 8px rgba(0, 242, 254, 0.5);
	}

	.btn-nav {
		background: linear-gradient(135deg, rgba(0, 242, 254, 0.15), rgba(9, 251, 211, 0.15));
		border: 1px solid var(--border-glass-glow);
		color: var(--neon-cyan);
		padding: 0.6rem 1.3rem;
		border-radius: 30px;
		font-weight: 600;
		font-size: 0.9rem;
		text-decoration: none;
		transition: all 0.3s ease;
		backdrop-filter: blur(8px);
	}

	.btn-nav:hover {
		background: linear-gradient(135deg, var(--neon-cyan), var(--neon-green));
		color: #0a0a0a;
		box-shadow: 0 0 20px rgba(0, 242, 254, 0.6);
		transform: translateY(-2px);
	}

	/* Main */
	main {
		flex: 1;
	}

	/* Footer */
	.footer {
		background: rgba(8, 8, 8, 0.9);
		border-top: 1px solid var(--border-glass);
		padding: 4rem 2rem 2rem;
		margin-top: 4rem;
	}

	.footer-container {
		max-width: 1200px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 2fr 1fr 1fr;
		gap: 3rem;

		@media (max-width: 768px) {
			grid-template-columns: 1fr;
		}
	}

	.footer-desc {
		color: var(--text-secondary);
		margin-top: 1rem;
		font-size: 0.95rem;
		max-width: 400px;
		line-height: 1.6;
	}

	.footer-links h4 {
		color: var(--text-primary);
		font-size: 1.1rem;
		margin-bottom: 1.2rem;
	}

	.footer-links ul {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
	}

	.footer-links a {
		color: var(--text-secondary);
		text-decoration: none;
		font-size: 0.9rem;
		transition: color 0.3s ease;
	}

	.footer-links a:hover {
		color: var(--neon-green);
	}

	.footer-bottom {
		max-width: 1200px;
		margin: 3rem auto 0;
		padding-top: 2rem;
		border-top: 1px solid rgba(255, 255, 255, 0.05);
		text-align: center;
		color: var(--text-muted);
		font-size: 0.85rem;
	}
</style>
